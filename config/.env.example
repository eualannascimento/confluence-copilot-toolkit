# Copie este arquivo para config/.env e preencha.
# config/.env NUNCA deve ser commitado (veja .gitignore).

# URL base da instância on-premise, sem barra no final.
CONFLUENCE_BASE_URL=https://confluence.suaempresa.com.br

# "pat" se sua instância permitir Personal Access Token
# (Confluence > ícone de perfil > Configurações de Personal Access Tokens).
# "basic" para usuário/senha (mais provável em instâncias antigas).
CONFLUENCE_AUTH_MODE=basic

# Modo "pat":
CONFLUENCE_PAT=

# Modo "basic":
CONFLUENCE_USER=
# Não preencha CONFLUENCE_PASSWORD aqui. Deixe em branco — o script pede a
# senha com getpass na primeira vez e, se o pacote `keyring` estiver
# instalado, guarda no cofre de credenciais do Windows/macOS para as
# próximas execuções.
CONFLUENCE_PASSWORD=
